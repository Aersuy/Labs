{
  "version": 1,
  "author": "Vlad Raileanu",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-arduino-mega", "id": "mega", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 140,
      "left": 300,
      "attrs": { "color": "red", "label": "FSM" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 220,
      "left": 230,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 150,
      "left": 20,
      "attrs": { "color": "green", "label": "EVENT", "bounce": "1" }
    }
  ],
  "connections": [
    [ "mega:13", "led1:A", "magenta", [ "h0" ] ],
    [ "led1:C", "r1:1", "magenta", [ "h0" ] ],
    [ "r1:2", "mega:GND.3", "black", [ "h0" ] ],

    [ "btn1:1.l", "mega:7", "green", [ "h0" ] ],
    [ "btn1:2.l", "mega:GND.1", "black", [ "h0" ] ],

    [ "mega:1", "$serialMonitor:RX", "" ],
    [ "mega:0", "$serialMonitor:TX", "" ]
  ],
  "serialMonitor": { "display": "terminal", "convertEol": true },
  "dependencies": {}
}