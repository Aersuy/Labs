{
  "version": 1,
  "author": "Vlad Raileanu",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-arduino-mega", "id": "mega", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-relay-module",
      "id": "relay1",
      "top": -230,
      "left": -220,
      "attrs": {}
    },
    {
      "type": "chip-peltier",
      "id": "peltier1",
      "top": -200,
      "left": 160,
      "attrs": { "ambient": "24", "tau": "20", "rate": "0.5" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 140,
      "left": 300,
      "attrs": { "color": "red", "label": "D" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 220,
      "left": 230,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "relay1:VCC", "mega:5V", "red", [ "h0" ] ],
    [ "relay1:GND", "mega:GND.2", "black", [ "h0" ] ],
    [ "relay1:IN", "mega:7", "orange", [ "h0" ] ],

    [ "relay1:COM", "mega:5V", "red", [ "h0" ] ],
    [ "relay1:NC", "peltier1:PWR", "purple", [ "h0" ] ],
    [ "peltier1:GND", "mega:GND.2", "black", [ "h0" ] ],

    [ "peltier1:VCC", "mega:5V", "red", [ "h0" ] ],
    [ "peltier1:OUT", "mega:A0", "green", [ "h0" ] ],

    [ "mega:12", "led1:A", "magenta", [ "h0" ] ],
    [ "led1:C", "r1:1", "magenta", [ "h0" ] ],
    [ "r1:2", "mega:GND.3", "black", [ "h0" ] ],

    [ "mega:1", "$serialMonitor:RX", "" ],
    [ "mega:0", "$serialMonitor:TX", "" ]
  ],
  "serialMonitor": {
    "display": "terminal",
    "convertEol": true,
    "newline": "lf",
    "collapse": false
  },
  "dependencies": {}
}
